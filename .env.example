# Copy to .env for local development; never commit real credentials.
VIVA_DATABASE_URL=sqlite:////data/viva.db
VIVA_PROVIDER_MODE=fixture
VIVA_DEMO_DATABASE=true
VIVA_SEED_DEMO=true
VIVA_ALLOWED_ORIGIN=http://localhost:3000
VIVA_RUN_INLINE_WORKER=false
VIVA_MEDIA_DIRECTORY=/data/media
VIVA_MAX_ACTIVE_SECONDS=600
VIVA_SESSION_EXPIRY_SECONDS=86400
VIVA_RETENTION_DAYS=30
VIVA_MAX_CONTEXT_TOKENS=12000
VIVA_PROVIDER_TIMEOUT=20
VIVA_EVALUATION_RETRY_LIMIT=3
VIVA_SESSION_SPEND_CAP=1.0
# Live calls require verified, dated upper-bound rates for the selected models.
# Supply JSON with version,effective_date,currency=USD,text_input_per_million,
# text_output_per_million,audio_per_minute. No rates are guessed by the app.
VIVA_PRICING_JSON={}
# Fixture mode is visibly labeled and does not make model calls or provide voice.
# Set openai and supply credentials/model access for real text/voice interviews.
OPENAI_API_KEY=
VIVA_VOICE_MODEL=gpt-realtime
VIVA_TEXT_MODEL=gpt-4.1-mini
NEXT_PUBLIC_API_BASE=/api/v1
# Production infrastructure values are reserved for a reviewed deployment.
# PostgreSQL requires a psycopg-enabled backend image and migrated data.
# VIVA_DATABASE_URL=postgresql+psycopg://viva:replace-me@postgres:5432/viva
# VIVA_DEMO_DATABASE=false
# VIVA_SEED_DEMO=false
# VIVA_DEMO_TOKENS={}
# VIVA_OIDC_ISSUER=https://identity.example
# VIVA_OIDC_AUDIENCE=viva-api
# VIVA_OIDC_JWKS_URL=https://identity.example/.well-known/jwks.json
# VIVA_OIDC_TENANT_CLAIM=tenant_id
# VIVA_OIDC_ROLES_CLAIM=roles
# VIVA_OBJECT_STORAGE_BUCKET=
# VIVA_OBJECT_STORAGE_ENDPOINT=
# VIVA_REDIS_URL=redis://redis:6379/0
