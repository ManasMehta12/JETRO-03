# Application title.
APP_NAME=Takumi Knowledge Engine
# Deployment environment; production forbids demo capabilities.
APP_ENV=development
# SQLite file initialized on startup.
DATABASE_URL=sqlite:///./data/takumi.db
# Enable development demo identities and data.
DEMO_MODE=true
# Enable signed demo login.
ENABLE_DEMO_AUTH=true
# Seed missing fixture task on startup without overwriting edits.
ENABLE_DEMO_SEED=true
# Allow reviewer-confirmed fixture reset.
ENABLE_DEMO_RESET=true
# Fresh databases start with release_001 approved.
DEMO_SEED_STATE=approved_baseline
# Answer only from active release snapshots.
ENABLE_GROUNDED_QA=true
# Export immutable training packs.
ENABLE_TRAINING_PACK_EXPORT=true
# Empty means generated per process; tokens expire on restart.
DEMO_SIGNING_SECRET=
# Token lifetime in minutes (1–1440).
DEMO_TOKEN_TTL_MINUTES=480
# fixture for deterministic Q&A/gaps; gemini or ollama enables worker extraction.
AI_PROVIDER=fixture
# Enable Gemini or Ollama extraction; requires ENABLE_MEDIA_PROCESSING=true.
ENABLE_LIVE_EXTRACTION=false
# reserved: Checkpoint 6, must stay false in V1.
ENABLE_LIVE_GAP_GENERATION=false
# reserved: Checkpoint 6, must stay false in V1.
ENABLE_LIVE_QA=false
# required when AI_PROVIDER=gemini; must be a video-capable model available to your key (not verified by this repo).
GEMINI_API_KEY=
# Required with GEMINI_API_KEY when AI_PROVIDER=gemini; no default model.
GEMINI_MODEL=
# required when AI_PROVIDER=ollama
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=
# WHISPER_BASE_URL=
# Accept validated MP4 uploads (requires ffprobe on PATH).
ENABLE_MEDIA_UPLOAD=false
# Accept durable processing jobs; requires ENABLE_MEDIA_UPLOAD=true.
ENABLE_MEDIA_PROCESSING=false
# Enable authenticated and signed-token playback.
ENABLE_MEDIA_STREAMING=false
# Upload size limit in MiB.
MAX_UPLOAD_MB=100
# Maximum recording duration in seconds.
MAX_VIDEO_DURATION_SECONDS=240
# Run the separate worker; requires ENABLE_MEDIA_PROCESSING=true.
ENABLE_PROCESSING_WORKER=false
# Retries after the first attempt.
PROCESSING_MAX_RETRIES=2
MEDIA_STORAGE_DIR=./data/media
PROCESSING_POLL_INTERVAL_SECONDS=2
# Lease must exceed provider timeout.
PROCESSING_JOB_LEASE_SECONDS=180
PROCESSING_PROVIDER_TIMEOUT_SECONDS=120
# reserved: Checkpoint 6, must stay false in V1.
ENABLE_MULTILINGUAL=false
# reserved: Checkpoint 6, must stay false in V1.
ENABLE_EMBEDDINGS=false
# reserved: Checkpoint 6, must stay false in V1.
ENABLE_ADVANCED_RETRIEVAL=false
# Standard library logging level.
LOG_LEVEL=INFO
# reserved: Checkpoint 6, must stay false.
LOG_MODEL_INPUTS=false
# Comma-separated allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Maximum declared request body size in KB.
MAX_REQUEST_BODY_KB=1024

# Live-mode example: set a real key/model above and uncomment these overrides.
# AI_PROVIDER=gemini
# ENABLE_MEDIA_UPLOAD=true
# ENABLE_MEDIA_STREAMING=true
# ENABLE_MEDIA_PROCESSING=true
# ENABLE_LIVE_EXTRACTION=true
# ENABLE_PROCESSING_WORKER=true
