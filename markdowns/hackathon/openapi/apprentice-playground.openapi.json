{
  "openapi": "3.0.3",
  "info": {
    "title": "Takumi Apprentice Playground",
    "version": "1.0.0",
    "description": "Proposed hackathon contract. See component plan and README for state, fixture and role invariants. All errors are JSON. No deployed implementation is implied."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "DemoSession": []
    }
  ],
  "paths": {
    "/playground/scenarios": {
      "get": {
        "operationId": "listPlaygroundScenarios",
        "summary": "List active public scenarios",
        "description": "Required role: learner.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Scenario"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden role or scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or inaccessible resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "State, revision or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request or unknown referenced value",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/playground/attempts": {
      "post": {
        "operationId": "startPlaygroundAttempt",
        "summary": "Bind approved versions and start practice",
        "description": "Required role: learner.",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Attempt"
                }
              }
            }
          },
          "401": {
            "description": "Invalid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden role or scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or inaccessible resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "State, revision or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request or unknown referenced value",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "Persist response by actor, route and key. Replay identical payload; reject changed payload with 409. Deduplicate before revision validation."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "scenario_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "guided",
                      "assessment"
                    ]
                  }
                },
                "required": [
                  "scenario_id",
                  "mode"
                ]
              }
            }
          }
        }
      }
    },
    "/playground/attempts/{attempt_id}": {
      "get": {
        "operationId": "getPlaygroundAttempt",
        "summary": "Restore public attempt state",
        "description": "Required role: learner.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Attempt"
                }
              }
            }
          },
          "401": {
            "description": "Invalid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden role or scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or inaccessible resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "State, revision or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request or unknown referenced value",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "attempt_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "/playground/attempts/{attempt_id}/actions": {
      "post": {
        "operationId": "submitPlaygroundAction",
        "summary": "Apply one reviewed deterministic transition",
        "description": "Required role: learner.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Attempt"
                }
              }
            }
          },
          "401": {
            "description": "Invalid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden role or scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or inaccessible resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "State, revision or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request or unknown referenced value",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "Persist response by actor, route and key. Replay identical payload; reject changed payload with 409. Deduplicate before revision validation."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "action_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "expected_revision": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "action_id",
                  "expected_revision"
                ]
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "attempt_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    }
  },
  "components": {
    "securitySchemes": {
      "DemoSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Preprovisioned opaque demo session; server resolves role and identity."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ]
      },
      "Evidence": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "video",
              "expert_response"
            ]
          },
          "author": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "media_id": {
            "type": "string",
            "minLength": 1
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "task_id",
          "type",
          "author"
        ]
      },
      "Task": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "equipment_context": {
            "type": "string"
          },
          "language": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "equipment_context",
          "language"
        ]
      },
      "Unit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "nullable": true
          },
          "cue": {
            "type": "string",
            "nullable": true
          },
          "interpretation": {
            "type": "string",
            "nullable": true
          },
          "decision": {
            "type": "string",
            "nullable": true
          },
          "exception": {
            "type": "string",
            "nullable": true
          },
          "support": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string",
                  "enum": [
                    "action",
                    "cue",
                    "interpretation",
                    "decision",
                    "exception"
                  ]
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "review": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "supported",
                    "unsupported"
                  ]
                }
              },
              "required": [
                "field",
                "evidence_ids",
                "review"
              ]
            }
          }
        },
        "required": [
          "id",
          "action",
          "cue",
          "interpretation",
          "decision",
          "exception",
          "support"
        ]
      },
      "Question": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "answered",
              "rejected",
              "deferred"
            ]
          }
        },
        "required": [
          "id",
          "unit_id",
          "prompt",
          "status"
        ]
      },
      "Job": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "awaiting_expert",
              "completed",
              "failed"
            ]
          },
          "stage": {
            "type": "string",
            "enum": [
              "queued",
              "media_preparation",
              "extraction",
              "gap_detection",
              "awaiting_expert",
              "revision",
              "validation",
              "completed",
              "failed"
            ]
          },
          "draft_id": {
            "type": "string",
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "state",
          "stage",
          "draft_id",
          "error"
        ]
      },
      "Draft": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "editing",
              "review",
              "published"
            ]
          },
          "units": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Unit"
            }
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Question"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          }
        },
        "required": [
          "id",
          "task_id",
          "revision",
          "status",
          "units",
          "questions",
          "evidence"
        ]
      },
      "Release": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "content_hash": {
            "type": "string"
          },
          "reviewer_id": {
            "type": "string",
            "minLength": 1
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          },
          "units": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Unit"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          }
        },
        "required": [
          "id",
          "task_id",
          "content_hash",
          "reviewer_id",
          "approved_at",
          "units",
          "evidence"
        ]
      },
      "Scenario": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "bundle_id": {
            "type": "string",
            "minLength": 1
          },
          "release_id": {
            "type": "string",
            "minLength": 1
          },
          "scene_template": {
            "type": "string"
          },
          "component_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "title",
          "version",
          "bundle_id",
          "release_id",
          "scene_template",
          "component_ids"
        ]
      },
      "Action": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label"
        ]
      },
      "Observation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "component_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text",
          "component_id"
        ]
      },
      "Feedback": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "text",
          "evidence_ids"
        ]
      },
      "Dimension": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "decision_accuracy",
              "evidence_gathering",
              "recognition_of_limits",
              "explanation_quality"
            ]
          },
          "earned": {
            "type": "integer",
            "minimum": 0
          },
          "available": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "earned",
          "available"
        ]
      },
      "Attempt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "scenario_version": {
            "type": "string",
            "minLength": 1
          },
          "bundle_id": {
            "type": "string",
            "minLength": 1
          },
          "bundle_hash": {
            "type": "string"
          },
          "release_id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "enum": [
              "guided",
              "assessment"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress",
              "completed"
            ]
          },
          "state": {
            "type": "string"
          },
          "available_actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Action"
            }
          },
          "observations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Observation"
            }
          },
          "feedback": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Feedback"
            }
          },
          "scores": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Dimension"
            }
          },
          "critical_error": {
            "type": "boolean"
          },
          "outcome": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "scenario_id",
          "scenario_version",
          "bundle_id",
          "bundle_hash",
          "release_id",
          "mode",
          "revision",
          "status",
          "state",
          "available_actions",
          "observations",
          "feedback",
          "scores",
          "critical_error",
          "outcome"
        ]
      },
      "VivaQuestion": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "label"
              ]
            }
          }
        },
        "required": [
          "id",
          "prompt",
          "options"
        ]
      },
      "VivaSession": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "attempt_id": {
            "type": "string",
            "minLength": 1
          },
          "bundle_id": {
            "type": "string",
            "minLength": 1
          },
          "bundle_hash": {
            "type": "string"
          },
          "release_id": {
            "type": "string",
            "minLength": 1
          },
          "bank_version": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress",
              "completed"
            ]
          },
          "answered_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "question_count": {
            "type": "integer",
            "enum": [
              3
            ]
          },
          "current_question": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VivaQuestion"
              }
            ],
            "nullable": true
          },
          "result_id": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "attempt_id",
          "bundle_id",
          "bundle_hash",
          "release_id",
          "bank_version",
          "revision",
          "status",
          "answered_count",
          "question_count",
          "current_question",
          "result_id"
        ]
      },
      "AnswerResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1
          },
          "option_id": {
            "type": "string",
            "minLength": 1
          },
          "reflection": {
            "type": "string"
          },
          "feedback": {
            "$ref": "#/components/schemas/Feedback"
          },
          "scores": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Dimension"
            }
          }
        },
        "required": [
          "question_id",
          "option_id",
          "feedback",
          "scores"
        ]
